# TripTogether 服务端环境变量模板
# 用法：复制为 .env 并填入真实值（cp .env.example .env）
# 注意：.env 含密钥，已被 .gitignore 忽略，不要提交！

# 数据库连接
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=请替换为真实数据库密码
DB_NAME=trip_together

# TypeORM：开发期 true（启动自动建/改表），生产建议 false
DB_SYNCHRONIZE=true

# 服务端口
PORT=3001

# JWT 配置（鉴权）
# JWT_SECRET 用于签发/校验 token，请用强随机值（如 openssl rand -hex 32）；生产环境务必独立生成
JWT_SECRET=change_me_to_a_strong_random_secret
# token 有效期，支持 "15m" / "7d" / "30d" 等
JWT_EXPIRES_IN=7d

# 交通班次查询（航班）：Aviationstack 免费层 Key
# 注册地址：https://aviationstack.com/  （免费档 100 次/月，实测需带 Key 才能返回真实数据）
# 未配置时航班查询会回退到演示 mock 数据，不影响交互联调
AVIATIONSTACK_KEY=

# 火车查询走 12306 官方公开接口，免 key、免注册，无需配置
