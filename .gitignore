# ===== 依赖 =====
node_modules/
.packages/
.pnp
.pnp.js

# ===== 构建产物 =====
dist/
build/
*.tsbuildinfo

# Vite 用 esbuild 直接编译 .ts，client/src 下不应出现 tsc 直吐的 .js/.d.ts
client/src/**/*.js
client/src/**/*.js.map
client/src/**/*.d.ts
# 例外：vite-env.d.ts 是 Vite 官方类型声明入口（提供 import.meta.env 类型），必须入库
!client/src/vite-env.d.ts
vite.config.ts.timestamp-*.mjs

# ===== 环境变量 / 密钥（切勿提交） =====
.env
.env.local
.env.*.local
!.env.example

# ===== 日志 / 运行时 =====
logs/
*.log
npm-debug.log*
server/data/
# 本地调试种子脚本（含硬编码 Token，勿入库）
server/scripts/
.npm-tmp/

# ===== 编辑器 / 系统 =====
.github/
.vscode/
.idea/
.DS_Store
*.swp
.workbuddy/
.husky/
overview.md

docs/
