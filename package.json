{
  "name": "trip-together",
  "version": "0.1.0",
  "private": true,
  "description": "多人协作旅游规划平台",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install",
    "lint": "npm --prefix server run lint",
    "typecheck": "npm --prefix client run typecheck && npm --prefix server run typecheck",
    "test": "npm --prefix server run test:run",
    "format": "npm --prefix server run format",
    "format:check": "npm --prefix server run format:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  }
}
